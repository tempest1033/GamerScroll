node_modules/
.env
.DS_Store

# HTML - reports만 예외
*.html
!reports/*.html

# 빌드 산출물 — main에서 분리, deploy-gamerscroll/deploy-aiscroll 브랜치로만 발행 (2026-07-28)
docs/
ai-docs/
/assets/
/styles-*.css

# 스냅샷 (로컬에서는 무시, GitHub Actions에서만 커밋)
snapshots/

# 빌드 캐시 (로컬/Actions 각자 관리)
.build-cache.json

# 임시 파일
tmp_*.json
tmpimg/
tmpimg-final/

# 인증 정보 (절대 커밋 금지)
credentials/
cache/search-console/

# 참고용 외부 코드 (yoastseo source 등 — local-only reference)
ref/

# 내부 순위 계측 모델 — 계산·검증 산출물은 로컬 전용, 저장소에는 코드만 (2026-09-14)
data/rank-models/
reports/rank-models/
reports/archive-bundles/
.venv-revenue/
.utmp/
__pycache__/

# 로컬 목업·격리 빌드 복사본
mockups/

# 로컬 dev 도우미 (디자인 비교/임시 처리용)
/dev-*.js
/ai-docs/_serve.js
/nul
/themed-*.html
/docs/themed-*.html
/ai-docs/themed-*.html
