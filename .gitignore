node_modules/
.env
.DS_Store

# HTML - index.html 제외, reports와 docs 포함
*.html
!reports/*.html
!docs/**/*.html
!ai-docs/**/*.html

# 스냅샷 (로컬에서는 무시, GitHub Actions에서만 커밋)
snapshots/

# 빌드 캐시 (로컬/Actions 각자 관리)
.build-cache.json

# 임시 파일
tmp_*.json

# 인증 정보 (절대 커밋 금지)
credentials/

# 참고용 외부 코드 (yoastseo source 등 — local-only reference)
ref/
