{
  "name": "gamerscroll",
  "version": "1.0.0",
  "description": "Game data and article site",
  "main": "generate-html-report.js",
  "scripts": {
    "build:gamerscroll": "node generate-html-report.js",
    "build:aiscroll": "node generate-ai-blog.js",
    "build": "npm run build:gamerscroll && npm run build:aiscroll",
    "start": "node generate-html-report.js",
    "x-article-card": "node generate-x-article-card.js",
    "x-article-post": "node post-article-to-x.js",
    "x-search": "node search-x.js",
    "x-article-all": "node generate-x-article-card.js && node post-article-to-x.js",
    "x-article-card-en": "node generate-x-article-card.js --lang en",
    "x-article-post-en": "node post-article-to-x.js --lang en",
    "x-aiscroll-all": "npm run x-article-card-en && npm run x-article-post-en"
  },
  "keywords": [
    "game",
    "news",
    "crawler",
    "youtube",
    "steam",
    "mobile-games"
  ],
  "author": "JYP",
  "license": "MIT",
  "dependencies": {
    "@google-analytics/data": "^4.12.1",
    "@mendable/firecrawl-js": "^4.7.0",
    "app-store-scraper": "^0.18.0",
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "cloudscraper": "^4.6.0",
    "dotenv": "^17.2.3",
    "google-play-scraper": "^10.1.2",
    "googleapis": "^171.4.0",
    "playwright": "^1.57.0",
    "playwright-extra": "^4.3.6",
    "puppeteer": "^24.31.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "twitter-api-v2": "^1.18.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "png-to-ico": "^3.0.1",
    "purgecss": "^8.0.0",
    "sharp": "^0.34.5",
    "to-ico": "^1.1.5"
  }
}
